{
  "name": "nexora-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "android:add": "cap add android && node scripts/patch-android-tv.mjs",
    "android:sync": "npm run build && cap sync android && node scripts/patch-android-tv.mjs",
    "android:open": "cap open android",
    "icons": "python3 scripts/gen-icons.py"
  },
  "dependencies": {
    "hls.js": "^1.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0"
  }
}